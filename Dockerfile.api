FROM python:3.12-slim

WORKDIR /app

# Install system dependencies & Typst
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && curl -fsSL https://github.com/typst/typst/releases/latest/download/typst-x86_64-unknown-linux-musl.tar.gz | tar -xz -C /usr/local/bin --strip-components=1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY core ./core
COPY adapters ./adapters
RUN mkdir -p storage/drafts

EXPOSE 8000

ENV PYTHONPATH=/app

CMD ["uvicorn", "adapters.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
